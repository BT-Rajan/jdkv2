# Copy this file to .env and fill in real values before running the backend.

# --- Shared MySQL database (perennia-auth / perennia-search / perennia-notify
#     / perennia-files / JDK's own tables all live here) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jdk

# --- perennia-auth (login/JWT only) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SIGNING_SECRET=1234567890
REQUIRE_EMAIL_VERIFICATION=true

# --- sentinel-auth (RBAC service, replaces perennia-access) ---
# Runs as its own service (see BT-Rajan/perennia-auth main branch); has its
# own DB, not the shared MySQL DB above. CLIENT_KEY is the UUID4 tenant key
# issued by that service for JDK.
SENTINEL_SERVICE_URL=http://localhost:4000
SENTINEL_CLIENT_KEY=1234567890

# --- perennia-files ---
FILES_SIGNING_SECRET=1234567890
FILES_STORAGE_PATH=./var/files
FILES_MAX_UPLOAD_SIZE=52428800

# --- Application ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- AI Factory Assistant (DeepSeek) ---
# Optional - leave DEEPSEEK_API_KEY blank and the assistant replies with a
# "not configured" message instead of failing.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

